{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "knob-filter-control-demo",
  "type": "registry:ui",
  "title": "Knob Filter Control Demo",
  "description": "Example: Knob Filter Control Demo.",
  "author": "ddtamn <https://github.com/ddtamn>",
  "dependencies": [],
  "registryDependencies": [
    "https://svelte-audio-ui.vercel.app/r/knob.json"
  ],
  "files": [
    {
      "target": "~/src/lib/components/ui/audio/examples/knob-filter-control-demo.svelte",
      "content": "<script lang=\"ts\">\n\timport { Knob } from \"$lib/components/ui/audio/elements/knob/index.js\";\n\n\tlet frequency = $state(2000);\n\tlet resonance = $state(30);\n\tlet mix = $state(50);\n\n\tfunction formatFreq(hz: number) {\n\t\treturn hz >= 1000 ? `${(hz / 1000).toFixed(1)}k` : `${hz}`;\n\t}\n</script>\n\n<div class=\"flex flex-wrap items-center justify-center gap-8\">\n\t<div class=\"flex flex-col items-center gap-2\">\n\t\t<Knob\n\t\t\tlabel=\"Freq\"\n\t\t\tvalue={((frequency - 20) / (20000 - 20)) * 100}\n\t\t\tonValueChange={(v) => (frequency = Math.round(20 + (v / 100) * (20000 - 20)))}\n\t\t\tsize=\"lg\"\n\t\t/>\n\t\t<span class=\"text-muted-foreground text-xs tabular-nums\">{formatFreq(frequency)} Hz</span>\n\t</div>\n\n\t<div class=\"flex flex-col items-center gap-2\">\n\t\t<Knob\n\t\t\tlabel=\"Res\"\n\t\t\tvalue={resonance}\n\t\t\tonValueChange={(v) => {\n\t\t\t\tresonance = v;\n\t\t\t}}\n\t\t\tsize=\"lg\"\n\t\t/>\n\t\t<span class=\"text-muted-foreground text-xs tabular-nums\">{resonance}%</span>\n\t</div>\n\n\t<div class=\"flex flex-col items-center gap-2\">\n\t\t<Knob\n\t\t\tlabel=\"Mix\"\n\t\t\tvalue={mix}\n\t\t\tonValueChange={(v) => {\n\t\t\t\tmix = v;\n\t\t\t}}\n\t\t\tsize=\"lg\"\n\t\t/>\n\t\t<span class=\"text-muted-foreground text-xs tabular-nums\">{mix}%</span>\n\t</div>\n</div>\n",
      "type": "registry:file"
    }
  ],
  "categories": [
    "audio",
    "example"
  ]
}