{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "knob-filter-control-demo",
  "type": "registry:ui",
  "title": "Knob Filter Control Demo",
  "description": "Example: Knob Filter Control Demo.",
  "author": "ddtamn <https://github.com/ddtamn>",
  "dependencies": [],
  "registryDependencies": [
    "https://svelte-audio-ui.vercel.app/r/knob.json"
  ],
  "files": [
    {
      "target": "~/src/lib/components/ui/audio/examples/knob-filter-control-demo.svelte",
      "content": "<script lang=\"ts\">\r\n\timport { Knob } from \"$lib/components/ui/audio/elements/knob/index.js\";\r\n\r\n\tlet frequency = $state(2000);\r\n\tlet resonance = $state(30);\r\n\tlet mix = $state(50);\r\n\r\n\tfunction formatFreq(hz: number) {\r\n\t\treturn hz >= 1000 ? `${(hz / 1000).toFixed(1)}k` : `${hz}`;\r\n\t}\r\n</script>\r\n\r\n<div class=\"flex flex-wrap items-center justify-center gap-8\">\r\n\t<div class=\"flex flex-col items-center gap-2\">\r\n\t\t<Knob\r\n\t\t\tlabel=\"Freq\"\r\n\t\t\tvalue={((frequency - 20) / (20000 - 20)) * 100}\r\n\t\t\tonValueChange={(v) => (frequency = Math.round(20 + (v / 100) * (20000 - 20)))}\r\n\t\t\tsize=\"lg\"\r\n\t\t/>\r\n\t\t<span class=\"text-muted-foreground text-xs tabular-nums\">{formatFreq(frequency)} Hz</span>\r\n\t</div>\r\n\r\n\t<div class=\"flex flex-col items-center gap-2\">\r\n\t\t<Knob\r\n\t\t\tlabel=\"Res\"\r\n\t\t\tvalue={resonance}\r\n\t\t\tonValueChange={(v) => {\r\n\t\t\t\tresonance = v;\r\n\t\t\t}}\r\n\t\t\tsize=\"lg\"\r\n\t\t/>\r\n\t\t<span class=\"text-muted-foreground text-xs tabular-nums\">{resonance}%</span>\r\n\t</div>\r\n\r\n\t<div class=\"flex flex-col items-center gap-2\">\r\n\t\t<Knob\r\n\t\t\tlabel=\"Mix\"\r\n\t\t\tvalue={mix}\r\n\t\t\tonValueChange={(v) => {\r\n\t\t\t\tmix = v;\r\n\t\t\t}}\r\n\t\t\tsize=\"lg\"\r\n\t\t/>\r\n\t\t<span class=\"text-muted-foreground text-xs tabular-nums\">{mix}%</span>\r\n\t</div>\r\n</div>\r\n",
      "type": "registry:file"
    }
  ],
  "categories": [
    "audio",
    "example"
  ]
}