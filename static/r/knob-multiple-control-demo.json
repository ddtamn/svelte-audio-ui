      "target": "~/src/lib/components/ui/audio/examples/knob-multiple-control-demo.svelte",
      "content": "<script lang=\"ts\">\r\n\timport { Knob } from \"$lib/components/ui/audio/elements/knob/index.js\";\r\n\r\n\tlet channels = $state([\r\n\t\t{ label: \"Vol\", value: 80 },\r\n\t\t{ label: \"Pan\", value: 50 },\r\n\t\t{ label: \"EQ Lo\", value: 60 },\r\n\t\t{ label: \"EQ Hi\", value: 40 },\r\n\t\t{ label: \"Reverb\", value: 25 },\r\n\t\t{ label: \"Delay\", value: 35 },\r\n\t]);\r\n</script>\r\n\r\n<div class=\"flex flex-wrap items-center justify-center gap-6\">\r\n\t{#each channels as channel (channel.label)}\r\n\t\t<div class=\"flex flex-col items-center gap-1\">\r\n\t\t\t<Knob\r\n\t\t\t\tlabel={channel.label}\r\n\t\t\t\tvalue={channel.value}\r\n\t\t\t\tonValueChange={(v) => (channel.value = v)}\r\n\t\t\t/>\r\n\t\t\t<span class=\"text-muted-foreground text-xs tabular-nums\">{channel.value}</span>\r\n\t\t</div>\r\n\t{/each}\r\n</div>\r\n",
      "type": "registry:file"
    }
