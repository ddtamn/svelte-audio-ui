{
	"name": "svelte-audio-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build:registry": "node ./scripts/build-registry.ts",
		"generate:registry": "bun run ./scripts/generate-registry.ts",
		"dev": "npm run build:registry && vite dev --port 5050",
		"dev:content": "velite dev --watch",
		"dev:svelte": "vite dev",
		"build": "npm run build:registry && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"publish-packages": "changeset publish"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@lucide/svelte": "^0.561.0",
		"@prettier/sync": "^0.6.1",
		"@shikijs/langs": "^4.0.2",
		"@shikijs/themes": "^4.0.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-vercel": "6.3.2",
		"@sveltejs/kit": "^2.50.2",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"mdsx": "^0.0.7",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rehype-pretty-code": "^0.14.3",
		"rehype-slug": "^6.0.0",
		"remark-code-import": "^1.2.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.0.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"svelte-meta-tags": "^4.5.1",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"unist-builder": "^4.0.0",
		"unist-util-visit": "^5.1.0",
		"velite": "^0.3.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@tabler/icons-svelte": "^3.40.0",
		"@threlte/core": "^8.5.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"cva": "npm:class-variance-authority",
		"mode-watcher": "^1.1.0",
		"package-manager-detector": "^1.6.0",
		"posthog-js": "^1.364.1",
		"runed": "^0.37.1",
		"svelte-dnd-action": "^0.9.69",
		"three": "^0.183.2",
		"wavesurfer.js": "^7.12.5",
		"zod": "^4.3.6"
	}
}
